# ============================================================
# TELEGRAM
# ============================================================
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...              # from @BotFather
ADMIN_IDS=111111111,222222222                     # comma-separated Telegram user IDs allowed to use the bot

# ============================================================
# WALLET  (use ONE of these two — never both, never commit this file)
# ============================================================
WALLET_MNEMONIC=
WALLET_PRIVATE_KEY_B58=

# ============================================================
# RPC / EXECUTION
# ============================================================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Current no-key Jupiter endpoint. The old quote-api.jup.ag/v6 endpoint is retired.
JUPITER_QUOTE_API=https://lite-api.jup.ag/swap/v1
JUPITER_PRICE_API=https://lite-api.jup.ag/price/v3

JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=100000

# ============================================================
# SAFETY / DEFAULTS
# ============================================================
DEFAULT_SLIPPAGE_BPS=500
DEFAULT_PRIORITY_FEE_MICROLAMPORTS=50000
MAX_BUY_SOL=2.0
RUGCHECK_API=https://api.rugcheck.xyz/v1

# ============================================================
# AUTO-SNIPER
# ============================================================
# The Telegram Sniper toggle is OFF by default. Turning it ON enables real buys.
# Start very small and increase only after observing live behavior.
AUTO_SNIPER_BUY_SOL=0.01
AUTO_SNIPER_MIN_LIQUIDITY_USD=25000
AUTO_SNIPER_MIN_MARKET_CAP_USD=50000
AUTO_SNIPER_MIN_VOLUME_5M_USD=1000
AUTO_SNIPER_MAX_PRICE_IMPACT_PCT=5
AUTO_SNIPER_COOLDOWN_SECONDS=900
AUTO_SNIPER_POLL_SECONDS=20

# ============================================================
# SMART STOP-LOSS
# ============================================================
# Keep the original SL while the trade is unproven.
# At +5% profit -> move SL to break-even.
# At +10% profit -> lock 50% of peak profit.
# Then ratchet the locked-profit level every +2% of new peak profit.
SMART_SL_ACTIVATION_PCT=5
SMART_SL_PROFIT_LOCK_START_PCT=10
SMART_SL_LOCK_RATIO=0.50
SMART_SL_RATCHET_STEP_PCT=2

# ============================================================
# STATE
# ============================================================
STATE_FILE=./state.json

# ============================================================
# WEB DASHBOARD
# ============================================================
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-this-to-a-long-random-password
