# ============================================================
# TELEGRAM
# ============================================================
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...              # from @BotFather
ADMIN_IDS=111111111,222222222                     # comma-separated Telegram user IDs allowed to use the bot

# ============================================================
# WALLET  (use ONE of these two — never both, never commit this file)
# ============================================================
# Option A: 12/24-word BIP39 mnemonic (derived via standard Solana path m/44'/501'/0'/0')
WALLET_MNEMONIC=
# Option B: Base58-encoded raw private key (e.g. exported from Phantom: Settings > Export Private Key)
WALLET_PRIVATE_KEY_B58=

# ============================================================
# RPC / EXECUTION
# ============================================================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com     # use a paid RPC (Helius/QuickNode/Triton) for real trading
JUPITER_QUOTE_API=https://quote-api.jup.ag/v6
JUPITER_PRICE_API=https://price.jup.ag/v6

# Jito block engine endpoint + tip (lamports) for MEV-protected landing
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=100000

# ============================================================
# SAFETY / DEFAULTS
# ============================================================
DEFAULT_SLIPPAGE_BPS=500          # 5%
DEFAULT_PRIORITY_FEE_MICROLAMPORTS=50000
MAX_BUY_SOL=2.0                   # hard cap per single/manual buy
RUGCHECK_API=https://api.rugcheck.xyz/v1

# ============================================================
# STATE
# ============================================================
STATE_FILE=./state.json

# ============================================================
# WEB DASHBOARD
# ============================================================
# Railway injects PORT automatically. The dashboard listens on it.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-this-to-a-long-random-password
