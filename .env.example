# ---- Telegram bot credentials ----
# Token from @BotFather
BOT_TOKEN=123456:your-bot-token-here

# Your numeric Telegram user id (or a comma-separated list of ids).
# The user(s) listed here get access to the /admin panel.
ADMIN_ID=123456789

# ---- Telethon / MTProto credentials ----
# Create these at https://my.telegram.org
API_ID=123456
API_HASH=your-api-hash-here

# REQUIRED for any host with an ephemeral filesystem (Railway, Render, Heroku, etc).
# Generate this ONCE locally by running `python generate_session.py` (logs in
# with a real user account -- not the bot token, see that file for why) and
# paste the printed string here / into your platform's env var settings.
TELETHON_SESSION_STRING=

# Local-dev-only fallback: if TELETHON_SESSION_STRING is unset, Telethon will
# cache a session in this file instead. Fine on your own machine; do NOT rely
# on this on Railway/Render/etc, since that disk does not persist across deploys.
TELETHON_SESSION=sessions/ad_bot_session

# ---- Database ----
# Any SQLAlchemy-compatible URL.
DATABASE_URL=sqlite:///./data/bot.db

# ---- Business rules (all overridable without touching code) ----
MIN_SUBSCRIBERS=1000
MIN_AVERAGE_VIEWS=200
MIN_REFERRAL_VIEWS=100
VERIFICATION_HOURS=24
OFFICIAL_BOT_USERNAME=Hfearnmoneyv4bot

AVERAGE_VIEWS_SAMPLE_SIZE=15
TRACKING_POLL_MINUTES=15
APPLY_RATE_LIMIT_SECONDS=30
