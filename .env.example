# ---- Telegram bot credentials ----
# Token from @BotFather
BOT_TOKEN=123456:your-bot-token-here

# Your numeric Telegram user id (or a comma-separated list of ids).
# The user(s) listed here get access to the /admin panel.
ADMIN_ID=123456789

# ---- Telethon / MTProto credentials ----
# Create these at https://my.telegram.org
API_ID=123456
API_HASH=your-api-hash-here

# Session name/path used by Telethon to persist login. The bot logs the
# Telethon client in with BOT_TOKEN, so no phone-number login is required.
TELETHON_SESSION=sessions/ad_bot_session

# ---- Database ----
DATABASE_URL=sqlite:///./data/bot.db

# ---- Business rules ----
MIN_SUBSCRIBERS=1000
MIN_AVERAGE_VIEWS=200
MIN_REFERRAL_VIEWS=100
VERIFICATION_HOURS=24
OFFICIAL_BOT_USERNAME=Hfearnmoneyv4bot
AVERAGE_VIEWS_SAMPLE_SIZE=15
TRACKING_POLL_MINUTES=15
APPLY_RATE_LIMIT_SECONDS=30
